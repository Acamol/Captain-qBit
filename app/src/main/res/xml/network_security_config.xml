<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
      Cleartext is permitted for self-hosted servers reached over plain HTTP on a LAN.
      HTTPS is validated against system CAs only. Self-signed servers are no longer trusted at
      the OS level via user-installed CAs - instead, the app pins a specific server's
      certificate in-app (see ClientManager.buildOkHttpClient / CertificateProbe) after the user
      explicitly reviews and approves its fingerprint for that one server.
    -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
